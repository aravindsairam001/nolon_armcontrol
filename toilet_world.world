<?xml version="1.0"?>
<sdf version="1.6">
  <world name="toilet_world">
    
    <!-- NOTE: Make sure the following models are available in your GAZEBO_MODEL_PATH:
         - toilet (from Dataset-of-Gazebo-Worlds-Models-and-Maps/worlds/office/office_part1/models/toilet)
         - bathroom_sink (from Dataset-of-Gazebo-Worlds-Models-and-Maps/worlds/office/models/bathroom_sink)
         - wastebasket (from Dataset-of-Gazebo-Worlds-Models-and-Maps/worlds/office/office_part1/models/wastebasket)
    -->
    
    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
        <!-- Plugin settings - Updated for gz-sim -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor for the bathroom -->
    <model name="bathroom_floor">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://Floor_room</uri>
      </include>
    </model>

    <!-- Floor -->
    <model name="floor">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>8 8 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>8 8 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.9 1</ambient>
            <diffuse>0.8 0.8 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bathroom walls - Positioned to form a proper rectangular room (4m x 4m) -->
    
    <!-- North wall (Y = -2.0, runs along X direction from X=-2 to X=+2) -->
    <model name="wall_north">
      <pose>0 -2.0 0 0 0 0</pose>
      <include>
        <uri>model://aws_robomaker_residential_RoomWall_01</uri>
      </include>
    </model>

    <!-- South wall (Y = +2.0, runs along X direction from X=-2 to X=+2) -->
    <model name="wall_south">
      <pose>0 2.0 0 0 0 0</pose>
      <include>
        <uri>model://aws_robomaker_residential_RoomWall_01</uri>
      </include>
    </model>

    <!-- West wall (X = -2.0, runs along Y direction from Y=-2 to Y=+2) -->
    <model name="wall_west">
      <pose>-2.0 0 0 0 0 1.57</pose>
      <include>
        <uri>model://aws_robomaker_residential_RoomWall_01</uri>
      </include>
    </model>

    <!-- East wall (X = +2.0, runs along Y direction from Y=-2 to Y=+2) -->
    <model name="wall_east">
      <pose>2.0 0 0 0 0 1.57</pose>
      <include>
        <uri>model://aws_robomaker_residential_RoomWall_01</uri>
      </include>
    </model>

    <!-- Ceiling light -->
    <!-- <model name="ceiling_light">
      <pose>0 0 2.8 0 0 0</pose>
      <include>
        <uri>model://aws_robomaker_residential_LightC_01</uri>
      </include>
    </model> -->

    <!-- Simple mirror using basic geometry -->
    <!-- <model name="mirror">
      <pose>-2.3 1.2 1.6 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.6 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.6 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.9 1</ambient>
            <diffuse>0.8 0.8 0.9 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model> -->

    <!-- Main toilet (positioned against west wall, rotated 90 degrees to face east) -->
    <model name="toilet">
      <pose>-1.2 0 0 0 0 1.57</pose>
      <include>
        <uri>model://toilet</uri>
      </include>
    </model>

    <!-- Bathroom sink (positioned against south wall, facing north wall) -->
    <model name="bathroom_sink">
      <pose>0 1.95 1.0 0 0 0</pose>
      <include>
        <uri>model://bathroom_sink</uri>
      </include>
    </model>
    
    <!-- Mirror above sink (using whiteboard model as mirror) -->
    <model name="bathroom_mirror">
      <pose>0 1.95 0 0 0 0</pose>
      <include>
        <uri>model://whiteboard</uri>
      </include>
    </model>
    
    <!-- Simple mirror using basic geometry (positioned above sink) -->
    <!-- <model name="mirror_simple">
      <pose>-1.8 1.0 1.6 0 0 1.57</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model> -->
    
    <!-- Overhead lighting -->
    <light type="point" name="bathroom_light">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

  </world>
</sdf>
