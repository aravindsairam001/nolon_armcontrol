<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_panda_robot">

  <!-- AMR Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <box size="0.8 0.6 0.8"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.4"/>
      <geometry>
      <box size="0.8 0.6 0.8"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <!-- Include Panda Robot -->
  <xacro:include filename="$(find moveit_resources_panda_description)/urdf/panda.urdf"/>
  
  <!-- Note: The panda.urdf is already instantiated, no need for macro call -->

  <!-- Connect Panda to AMR base -->
  <joint name="amr_to_panda" type="fixed">
    <parent link="base_link"/>
    <child link="panda_link0"/>
    <origin xyz="0.2 0.0 0.8" rpy="0 0 0"/>
  </joint>

<ros2_control name="PandaSystem" type="system">
  <hardware>
    <plugin>fake_components/GenericSystem</plugin>
  </hardware>
  <joint name="panda_joint1">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint2">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint3">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint4">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint5">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint6">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="panda_joint7">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

</robot>